{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maistr0.dev/schemas/shard-membership.schema.json",
  "title": "Shard membership request",
  "type": "object",
  "required": ["node_ids"],
  "properties": {
    "node_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "\\S" }
    }
  },
  "additionalProperties": false
}
