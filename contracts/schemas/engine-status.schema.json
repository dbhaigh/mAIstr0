{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maistr0.dev/contracts/schemas/engine-status.schema.json",
  "title": "EngineStatus",
  "type": "object",
  "required": ["name", "ready", "model_count"],
  "properties": {
    "name": {"type": "string"},
    "ready": {"type": "boolean"},
    "protocols": {"type": "array", "items": {"type": "string"}},
    "capabilities": {
      "type": "object",
      "properties": {
        "devices": {"type": "array", "items": {"type": "string", "enum": ["cpu", "gpu", "npu"]}},
        "backends": {"type": "array", "items": {"type": "string"}},
        "npu_vendors": {"type": "array", "items": {"type": "string"}},
        "quantizations": {"type": "array", "items": {"type": "string"}},
        "primary_quantization": {"type": "string"},
        "modalities": {"type": "array", "items": {"type": "string"}},
        "max_parallel_seqs": {"type": "integer", "minimum": 0},
        "max_context_length": {"type": "integer", "minimum": 0},
        "requires_context_cap": {"type": "boolean"},
        "supports_sharding": {"type": "array", "items": {"type": "string", "enum": ["llamacpp-rpc", "vllm-mp", "vllm-ray"]}},
        "homogeneous_only": {"type": "boolean"},
        "os": {"type": "array", "items": {"type": "string"}},
        "validated_rpc": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "capabilities_error": {"type": "string"},
    "inventory_state": {"type": "string", "enum": ["unknown", "available", "empty", "error"]},
    "model_count": {"type": "integer", "minimum": 0},
    "last_checked_at": {"type": "string", "format": "date-time"},
    "last_successful_at": {"type": "string", "format": "date-time"},
    "last_error": {"type": "string"},
    "pipeline_stage": {"$ref": "pipeline-stage-capabilities.schema.json"},
    "pipeline_stage_error": {"type": "string"}
  },
  "additionalProperties": true
}
