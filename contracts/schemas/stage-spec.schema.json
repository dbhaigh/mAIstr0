{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maistr0.dev/contracts/schemas/stage-spec.schema.json",
  "title": "StageSpec",
  "type": "object",
  "required": ["node_id", "start_layer", "end_layer", "engine"],
  "properties": {
    "node_id": {"type": "string", "minLength": 1},
    "start_layer": {"type": "integer", "minimum": 0},
    "end_layer": {"type": "integer", "minimum": 1},
    "engine": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
