{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maistr0.dev/contracts/schemas/release-catalog.schema.json",
  "title": "ReleaseCatalog",
  "type": "object",
  "required": ["version", "artifacts", "signature"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
    },
    "artifacts": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["os", "arch", "path", "sha256", "size"],
        "properties": {
          "os": {"type": "string", "enum": ["windows", "linux", "darwin"]},
          "arch": {"type": "string", "enum": ["amd64", "arm64"]},
          "path": {"type": "string", "minLength": 1, "maxLength": 1024},
          "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "size": {"type": "integer", "minimum": 1, "maximum": 134217728}
        },
        "additionalProperties": false
      }
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$",
      "description": "Standard-base64 Ed25519 signature over the catalog with this field omitted."
    }
  },
  "additionalProperties": false
}
