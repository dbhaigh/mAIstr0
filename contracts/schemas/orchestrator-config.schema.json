{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maistr0.dev/contracts/schemas/orchestrator-config.schema.json",
  "title": "OrchestratorConfig",
  "type": "object",
  "required": ["listen_addr", "harness", "max_concurrent_dispatches", "dispatch_timeout_seconds", "discovery_enabled", "auto_open_browser", "tray_mode", "memory_path"],
  "properties": {
    "listen_addr": {"type": "string"},
    "log_level": {"type": "string", "enum": ["debug", "info", "warn", "error"], "default": "info"},
    "mode": {"type": "string", "enum": ["full", "minimal"]},
    "harness": {"type": "string", "enum": ["deepseek", "pi"]},
    "max_concurrent_dispatches": {"type": "integer"},
    "dispatch_timeout_seconds": {"type": "integer", "minimum": 1, "default": 1800},
    "speculative_hedging_enabled": {"type": "boolean", "default": false},
    "max_concurrent_hedges": {"type": "integer", "minimum": 1, "maximum": 4, "default": 1},
    "router_time_to_first_byte_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 120, "default": 60},
    "router_idle_stream_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 120, "default": 30},
    "router_requests_per_minute": {"type": "integer", "minimum": 0, "maximum": 100000, "default": 0},
    "router_max_concurrent_per_client": {"type": "integer", "minimum": 0, "maximum": 1024, "default": 0},
    "sharded_models": {
      "type": "array",
      "items": {"$ref": "sharded-model-config.schema.json"}
    },
    "sync_max_bytes": {"type": "integer", "minimum": 1, "maximum": 268435456, "default": 67108864},
    "sync_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600, "default": 600},
    "discovery_enabled": {"type": "boolean"},
    "discovery_hmac_secret": {"type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$", "description": "Optional base64-encoded 32-byte cluster discovery HMAC key. Use the same value on every cluster member; omitted keeps legacy unauthenticated discovery."},
    "auto_open_browser": {"type": "boolean"},
    "tray_mode": {"type": "string", "enum": ["taskbar", "hidden"]},
    "memory_path": {"type": "string"}
  },
  "additionalProperties": true
}
