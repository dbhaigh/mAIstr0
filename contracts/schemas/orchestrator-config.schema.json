{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maistr0.dev/contracts/schemas/orchestrator-config.schema.json",
  "title": "OrchestratorConfig",
  "type": "object",
  "required": ["listen_addr", "harness", "max_concurrent_dispatches", "dispatch_timeout_seconds", "discovery_enabled", "auto_open_browser", "tray_mode", "memory_path"],
  "properties": {
    "listen_addr": {"type": "string"},
    "mode": {"type": "string", "enum": ["full", "minimal"]},
    "harness": {"type": "string", "enum": ["deepseek", "pi"]},
    "max_concurrent_dispatches": {"type": "integer"},
    "dispatch_timeout_seconds": {"type": "integer", "minimum": 1},
    "discovery_enabled": {"type": "boolean"},
    "auto_open_browser": {"type": "boolean"},
    "tray_mode": {"type": "string", "enum": ["taskbar", "hidden"]},
    "memory_path": {"type": "string"}
  },
  "additionalProperties": true
}
