{
  "name": "task-not-found",
  "request": {
    "method": "GET",
    "path": "/api/tasks/unknown",
    "variants": [
      {
        "method": "POST",
        "path": "/api/tasks/unknown/cancel"
      },
      {
        "method": "POST",
        "path": "/api/tasks/unknown/approve"
      },
      {
        "method": "POST",
        "path": "/api/tasks/unknown/resume"
      },
      {
        "method": "GET",
        "path": "/api/tasks/unknown/checkpoints"
      }
    ]
  },
  "expected_response": {
    "status": 404,
    "content_type": "text/plain; charset=utf-8",
    "body": "task not found\n"
  },
  "normalization_rules": [
    "Replace timestamps with \u003cTIME\u003e.",
    "Replace generated task and checkpoint IDs with \u003cTASK_ID\u003e and \u003cCHECKPOINT_ID\u003e.",
    "Replace local worker URLs with \u003cWORKER_URL\u003e.",
    "Normalize volatile scores, task origins, and sequences as documented by the Go contract tests."
  ]
}
