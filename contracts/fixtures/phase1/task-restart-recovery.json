  "normalization_rules": [
    "Replace timestamps with \u003cTIME\u003e.",
    "Replace generated task and checkpoint IDs with \u003cTASK_ID\u003e and \u003cCHECKPOINT_ID\u003e.",
    "Replace local worker URLs with \u003cWORKER_URL\u003e.",
